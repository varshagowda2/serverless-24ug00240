# Public Supabase credentials for Vite Frontend
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-here

# Supabase Edge Function URL (or local proxy URL)
# For production Supabase Edge Function: https://your-supabase-project-id.supabase.co/functions/v1/sanitize-input
# For local dev fallback runner: http://localhost:3001/api/sanitize-input
VITE_SUPABASE_FUNCTION_URL=http://localhost:3001/api/sanitize-input

# SERVER-SIDE ONLY (NEVER expose to frontend!)
SUPABASE_SECRET_KEY=your-supabase-secret-key-here
PORT=3001
